Options -Indexes

# Bound request bodies to reduce memory/disk exhaustion from oversized uploads.
LimitRequestBody 8388608

RewriteEngine On

# Open the public sign-in page when visitors use the bare domain.
RewriteRule ^$ login.html [R=302,L]

# Public entry points are stored under /public but exposed as clean root routes.
RewriteRule ^login\.html$ public/login.html [END,QSA]
RewriteRule ^bystander-sos\.html$ public/bystander-sos.html [END,QSA]
RewriteRule ^sos\.html$ public/bystander-sos.html [END,QSA]

# Operational HTML routes are server-gated.
RewriteRule ^index\.html$ page-gate.php?page=dashboard [END,QSA]
RewriteRule ^responder\.html$ page-gate.php?page=responder [END,QSA]
RewriteRule ^latest-incidents\.html$ page-gate.php?page=latest-incidents [END,QSA]
RewriteRule ^responder-sos\.html$ page-gate.php?page=responder-sos [END,QSA]

# Never expose private templates or server-side application folders directly.
RewriteRule ^page-gate\.php$ - [F,L]
RewriteRule ^pages(?:/|$) - [F,L]
RewriteRule ^public(?:/|$) - [F,L]
RewriteRule ^config(?:/|$) - [F,L]
RewriteRule ^includes(?:/|$) - [F,L]
RewriteRule ^database(?:/|$) - [F,L]
RewriteRule ^docs(?:/|$) - [F,L]

# API is same-origin. No localhost CORS header is needed in production.
# Enforce HTTPS on non-localhost deployments. Local XAMPP remains usable over HTTP.
# If TLS terminates at a trusted reverse proxy, respect its forwarded-proto header.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), notifications=(self)"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Start in Report-Only mode: observe violations before enforcing a CSP.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: ws: wss:; media-src 'self' blob:;"
</IfModule>

# Never expose SQL migration/reset files.
<FilesMatch "\.(sql|md|example)$">
    Require all denied
</FilesMatch>

<Files "setup-admin.php">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
</Files>
